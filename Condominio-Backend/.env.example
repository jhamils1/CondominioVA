SECRET_KEY=mi_clave_secreta
# Clave Fernet independiente para proteger credenciales de cámaras; generar localmente.
CAMARAS_CLAVE_CIFRADO=
DEBUG=True
DATABASE_URL=postgres://usuario:password@localhost:5432/mi_db
# Opcional: ruta local al JSON privado de la cuenta de servicio (fuera de Git).
# FIREBASE_CREDENTIALS_PATH=C:/ruta/privada/firebase-admin.json
# Si FIREBASE_CREDENTIALS_JSON está definido, tiene prioridad sobre la ruta.
# Activar solo después de aplicar la migración de notificaciones de seguridad.
NOTIFICACIONES_SEGURIDAD_ACTIVAS=False
COLA_FCM_SEGURIDAD_ACTIVA=False
ENVIO_FCM_SEGURIDAD_ACTIVO=False
# Durante una transición de proyecto Firebase, False pausa el push de expensas y objetos perdidos.
ENVIO_FCM_LEGADO_ACTIVO=True

# Proveniencia FCM: activar solo tras migrar y verificar en el entorno.
FCM_PROCEDENCIA_ACTIVA=False
FCM_PROYECTO_ID=
